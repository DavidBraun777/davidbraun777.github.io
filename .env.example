# Required in production for contact form delivery.
# Get your API key from https://resend.com.
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Preferred server-only recipient for contact form notifications.
CONTACT_NOTIFICATION_EMAIL=you@example.com

# Legacy recipient fallback supported by code if CONTACT_NOTIFICATION_EMAIL is unset.
# CONTACT_EMAIL=you@example.com

# Sender identity used by the website contact form.
# CONTACT_FROM_EMAIL must be verified in Resend if changed.
CONTACT_FROM_EMAIL=contact@dbraun.io
CONTACT_FROM_NAME=dbraun.io Contact

# Optional: Calendly event link for direct scheduling in the contact section.
CAL_LINK=https://calendly.com/your-handle/intro-call

# Required when NODE_ENV=production, including Vercel Preview deployments.
# Missing/unavailable Redis protection returns 503; memory fallback is dev/test only.
# Use the HTTPS REST endpoint and a server-only token with rate-limit write access.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Vercel supplies VERCEL=1 and VERCEL_URL; enable system environment variables.
# Do not set VERCEL manually on another host to trust caller-supplied IP headers.
# See docs/security-hardening-report.md for deployment verification steps.

# Optional: Google Analytics 4 measurement ID. Leave unset to disable GA.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
